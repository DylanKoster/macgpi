[flake8]
# Line length
max-line-length = 120

# Ignore common style issues (optional, adjust as needed)
ignore = E203,W503
    # E203: whitespace before ':'
    # W503: line break before binary operator

# Exclude patterns
exclude = .git,__pycache__,.venv,.venv/,venv/,*.egg-info,build/,dist/

# Show source code in error messages
show-source = True
