{
    "phases": {
        "plan": {
            "inputs": {
                "system_prd": "docs/project_description.md"
            },
            "schema": true,
            "path": "01_plan/",
            "output_path": "docs/implementation_plan.json",
            "next": "implement"
        },
        "implement": {
            "inputs": {
                "system_prd": "docs/project_description.md",
                "implementation_plan": "docs/implementation_plan.json"
            },
            "schema": false,
            "path": "02_implement/",
            "next": "evaluate"
        },
        "evaluate": {
            "inputs": {
                "system_prd": "docs/project_description.md",
                "implementation_plan": "docs/implementation_plan.json"
            },
            "schema": true,
            "path": "03_evaluate/",
            "output_path": "docs/evaluation_report.json",
            "next": "finish"
        },
        "revise": {
            "inputs": {
                "system_prd": "docs/project_description.md",
                "implementation_plan": "docs/implementation_plan.json",
                "evaluation_report": "docs/evaluation_report.json"
            },
            "schema": false,
            "path": "04_revise/",
            "next": "evaluate"
        }
