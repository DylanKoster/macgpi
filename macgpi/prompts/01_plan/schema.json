{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Planning Phase Schema",
    "description": "Schema for the planning phase output of a maintainable software artifact generation pipeline",
    "type": "object",
    "required": [
        "objectives",
        "architecture",
        "components",
        "dependencies",
        "implementation_tasks",
        "quality_standards"
    ],
    "properties": {
        "objectives": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "description",
                    "priority"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the objective, e.g., OBJ-001"
                    },
                    "description": {
                        "type": "string",
                        "description": "Detailed description of the objective"
                    },
                    "priority": {
                        "enum": [
                            "high",
                            "medium",
                            "low"
                        ]
                    },
                    "metrics": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Optional metrics to measure the success of the objective"
                    }
                }
            },
            "description": "Primary goals and requirements for the software artifact"
        },
        "architecture": {
            "type": "object",
            "required": [
                "pattern",
                "rationale"
            ],
            "properties": {
                "pattern": {
                    "type": "string",
                    "examples": [
                        "MVC",
                        "microservices",
                        "layered"
                    ],
                    "description": "Chosen architectural pattern for the software artifact"
                },
                "rationale": {
                    "type": "string",
                    "description": "Justification for the chosen architectural pattern"
                },
                "constraints": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Any constraints or limitations that influenced the architectural decisions"
                }
            },
            "description": "High-level architectural decisions"
        },
        "components": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "responsibility"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Name of the component or module"
                    },
                    "responsibility": {
                        "type": "string",
                        "description": "Description of the component's responsibility or role in the system"
                    },
                    "interfaces": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "List of interfaces or APIs provided by the component"
                    },
                    "testability": {
                        "type": "string",
                        "description": "How how the component can be tested"
                    }
                }
            },
            "description": "Planned components and modules"
        },
        "dependencies": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "type"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Name of the external library or internal component"
                    },
                    "type": {
                        "enum": [
                            "external",
                            "internal"
                        ]
                    },
                    "version": {
                        "type": "string",
                        "description": "Version of the dependency, if applicable"
                    },
                    "justification": {
                        "type": "string",
                        "description": "Justification for using this dependency"
                    }
                }
            },
            "description": "External libraries and internal component dependencies"
        },
        "implementation_tasks": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "title",
                    "component",
                    "description"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the task, e.g., TASK-001"
                    },
                    "title": {
                        "type": "string",
                        "description": "Title or name of the implementation task"
                    },
                    "component": {
                        "type": "string",
                        "description": "Name of the component this task belongs to"
                    },
                    "description": {
                        "type": "string",
                        "description": "Detailed description of the implementation task"
                    },
                    "depends_on": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "IDs of tasks that must be completed before this one"
                    },
                    "acceptance_criteria": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Criteria that must be met for the task to be considered complete"
                    }
                }
            },
            "description": "Ordered list of concrete implementation tasks derived from the components and architecture"
        },
        "quality_standards": {
            "type": "object",
            "properties": {
                "coding_standards": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "List of coding standards to be followed, e.g., PEP 8 for Python"
                },
                "documentation_level": {
                    "enum": [
                        "minimal",
                        "standard",
                        "comprehensive"
                    ],
                    "description": "Level of documentation to be provided"
                },
                "test_coverage_target": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Target percentage of code coverage for automated tests"
                }
            },
            "description": "Maintainability and quality benchmarks"
        }
    }
}