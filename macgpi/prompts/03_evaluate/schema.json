{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Implementation Evaluation Schema",
  "description": "Schema for structured evaluation output of an implementation against a PRD and plan",
  "type": "object",
  "required": [
    "evaluated_at",
    "evaluated_by",
    "overall_rating",
    "summary",
    "findings",
    "recommendations",
    "next"
  ],
  "properties": {
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when evaluation was performed"
    },
    "evaluated_by": {
      "type": "string",
      "description": "Name or identifier of the evaluator"
    },
    "overall_rating": {
      "type": "string",
      "enum": ["pass", "conditional", "fail"],
      "description": "High-level verdict for the implementation"
    },
    "summary": {
      "type": "string",
      "description": "Concise summary of the evaluation (1-3 sentences)"
    },
    "compliance": {
      "type": "array",
      "description": "List of PRD/requirements items and whether they are satisfied",
      "items": {
        "type": "object",
        "required": ["requirement_id", "status"],
        "properties": {
          "requirement_id": { "type": "string" },
          "status": { "enum": ["met", "partially_met", "unmet"] },
          "notes": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Concrete issues, gaps, or observations discovered during evaluation",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "description"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "impact": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "string" }
        }
      }
    },
    "test_results": {
      "type": "object",
      "description": "Summary of test executions and coverage",
      "properties": {
        "unit": {
          "type": "object",
          "properties": {
            "status": { "enum": ["passed", "failed", "partial"] },
            "passing": { "type": "integer" },
            "failing": { "type": "integer" },
            "coverage_pct": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "integration": {
          "type": "object",
          "properties": {
            "status": { "enum": ["passed", "failed", "partial"] },
            "notes": { "type": "string" }
          }
        },
        "e2e": {
          "type": "object",
          "properties": {
            "status": { "enum": ["passed", "failed", "partial"] },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "description": "Numeric metrics or KPIs relevant to acceptance",
      "additionalProperties": { "type": ["number", "string"] }
    },
    "recommendations": {
      "type": "array",
      "description": "Prioritized, actionable recommendations to remediate findings",
      "items": {
        "type": "object",
        "required": ["id", "action", "priority"],
        "properties": {
          "id": { "type": "string" },
          "action": { "type": "string" },
          "priority": { "enum": ["urgent", "high", "medium", "low"] },
          "owner": { "type": "string" },
          "verification": { "type": "string" }
        }
      }
    },
    "dependencies_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["external", "internal"] },
          "version": { "type": "string" },
          "risk": { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    },
    "quality_standards": {
      "type": "object",
      "properties": {
        "coding_standards": { "type": "array", "items": { "type": "string" } },
        "documentation": { "type": "string" },
        "test_coverage_target": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "next": {
      "type": "string",
      "description": "Indicates the next phase to execute. Can ONLY be 'finish' or 'revise'. If 'finish', the pipeline will proceed to finish. If 'revise', the pipeline will loop back to the revise phase for further improvements."
    }
  },
  "additionalProperties": false
}
